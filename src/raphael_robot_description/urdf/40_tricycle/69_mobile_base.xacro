<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 定义基准尺寸（单位：米） -->
    <xacro:property name="base_length" value="0.6"/>
    <xacro:property name="base_width" value="0.4"/>
    <xacro:property name="base_height" value="0.2"/>
    <xacro:property name="wheel_radius" value="0.1"/>
    <xacro:property name="wheel_length" value="0.05"/>

    <!-- 🎯 全局缩放系数 -->
    <xacro:property name="scale" value="0.1"/>

    <!-- ========== 基座 footprint ========== -->
    <link name="base_footprint_tricycle"/>

    <!-- ========== base_link ========== -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length * scale} ${base_width * scale} ${base_height * scale}"/>
            </geometry>
            <origin xyz="0 0 ${base_height * scale / 2.0}" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length * scale} ${base_width * scale} ${base_height * scale}"/>
            </geometry>
            <origin xyz="0 0 ${base_height * scale / 2.0}" rpy="0 0 0"/>
        </collision>
        <xacro:tricycle_box_inertia m="200.0" x="${base_length*scale}" y="${base_width*scale}" z="${base_height*scale}"
                                    o_xyz="0 0 ${base_height*scale/2.0}" o_rpy="0 0 0"/>
    </link>

    <!-- ========== 轮子宏 ========== -->
    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <!-- 视觉：圆柱 -->
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius * scale}" length="${wheel_length * scale}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
                <material name="grey"/>
            </visual>
            <!-- 碰撞：球体 -->
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius * scale}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>

            <xacro:tricycle_cylinder_inertia m="10" r="${wheel_radius*scale}" l="${wheel_length*scale}" o_xyz="0 0 0" o_rpy="0 0 0"/>
        </link>
    </xacro:macro>

    <!-- 实例化左右轮子 -->
    <xacro:wheel_link prefix="right"/>
    <xacro:wheel_link prefix="left"/>

    <!-- ========== 万向轮（脚轮） ========== -->
    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${wheel_radius * scale / 2.0}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius * scale / 2.0}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:tricycle_sphere_inertia m="10" r="${wheel_radius*scale/2.0}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <!-- ========== 关节 ========== -->
    <joint name="base_tricycle_joint" type="fixed">
        <parent link="base_footprint_tricycle"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius * scale}" rpy="0 0 0"/>
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="${-base_length * scale / 4.0} ${-(base_width + wheel_length) * scale / 2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="${-base_length * scale / 4.0} ${(base_width + wheel_length) * scale / 2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="${base_length * scale / 3.0} 0 ${-wheel_radius * scale / 2.0}" rpy="0 0 0"/>
    </joint>

</robot>